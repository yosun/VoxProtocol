      },
      "RightsRevenueAllocation": {
        "$ref": "../packages/protocol/schemas/realize-v1.schema.json#/$defs/RightsRevenueAllocation"
      },
      "RightsRevenueEvent": {
        "$ref": "../packages/protocol/schemas/realize-v1.schema.json#/$defs/RightsRevenueEvent"
      },
      "RightsTerminationAcceptance": {
        "$ref": "../packages/protocol/schemas/realize-v1.schema.json#/$defs/RightsTerminationAcceptance"
      },
      "SettlementAcknowledgment": {
        "$ref": "../packages/protocol/schemas/realize-v1.schema.json#/$defs/SettlementAcknowledgment"
      },
      "SettlementInstruction": {
        "$ref": "../packages/protocol/schemas/realize-v1.schema.json#/$defs/SettlementInstruction"
      },
      "UsdcAtomic": {
        "$ref": "../packages/protocol/schemas/realize-v1.schema.json#/$defs/UsdcAtomic"
      },
      "WebhookAcknowledgment": {
        "$ref": "../packages/protocol/schemas/realize-v1.schema.json#/$defs/WebhookAcknowledgment"
      }
    }
  }
}
