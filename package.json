{
  "name": "vox-protocol",
  "version": "1.0.0",
  "private": true,
  "description": "Private VOX Protocol and VOX.gold monorepo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*",
    "integrations/*"
  ],
  "scripts": {
    "anchor:setup": "node scripts/setup-anchor.mjs",
    "bob:publish": "npm run publish --workspace @vox/bob",
    "bob:avatar": "npm run avatar --workspace @vox/bob",
    "bob:identity": "npm run identity --workspace @vox/bob",
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build --workspace @vox/protocol && npm run build --workspace @vox/identity && npm run build --workspace @vox/merkle && npm run build --workspace @vox/solana && npm run build --workspace @vox/realize-solana && npm run build --workspace @vox/media-provider && npm run build --workspace @vox/client",
    "build:realize-contracts": "npm run build --workspace @vox/realize-contracts",
    "build:apps": "npm run build --workspace @vox/api && npm run build --workspace @vox/anchor && npm run build --workspace @vox/realize-settlement && npm run build --workspace @vox/bob && npm run build --workspace @vox/web",
    "dev:api": "npm run dev --workspace @vox/api",
    "dev:web": "npm run dev --workspace @vox/web",
    "test": "npm run typecheck && vitest run",
    "test:firestore": "sh scripts/test-firestore.sh",
    "test:firestore:run": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 vitest run tests/firestore.integration.test.ts --testTimeout=30000",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:realize-escrow": "sh scripts/test-realize-escrow.sh",
    "test:realize-escrow:local-validator": "npx tsx scripts/test-realize-escrow-local-validator.ts",
    "initialize:realize-devnet": "tsx scripts/initialize-realize-devnet-config.ts",
    "test:realize-escrow:devnet": "tsx scripts/test-realize-escrow-devnet.ts",
    "preflight:realize-staging": "tsx scripts/preflight-realize-staging.ts",
    "deploy:realize-staging": "tsx scripts/deploy-realize-staging.ts",
    "bootstrap:realize-staging": "tsx scripts/bootstrap-realize-staging.ts",
    "prepare:realize-staging-payment": "tsx scripts/prepare-realize-staging-payment.ts",
    "rehearse:realize-staging": "tsx scripts/run-realize-staging-rehearsal.ts",
    "rehearse:realize-staging-refund": "tsx scripts/run-realize-staging-refund-rehearsal.ts",
    "validate:nft-testnets": "tsx scripts/validate-nft-testnets.ts",
    "typecheck": "npm run build && npx tsc -p apps/web/tsconfig.json --noEmit",
    "verify": "npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "22.15.21",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.4.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.2"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@google-cloud/firestore": "7.11.0",
    "@google-cloud/storage": "7.16.0",
    "@google-cloud/tasks": "6.2.0",
    "@solana/web3.js": "1.98.4",
    "fastify": "5.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tweetnacl": "1.0.3",
    "zod": "3.25.20"
  }
}
