# Owner-approved Mainnet NFT deployment template. This file contains no secrets.
# Keep disabled until Solana/ Base/ Monad contracts, RPCs, signer identities,
# and a real-funds approval have all been recorded and testnets have passed.
VOX_DEPLOYMENT_ENV=production
VOX_NFT_ENABLED=false
VOX_NFT_MAINNET_ENABLED=false
VOX_CONFIRM_NFT_MAINNET=0
VOX_NFT_CHAINS=solana:mainnet-beta,base:mainnet,monad:mainnet,arbitrum:mainnet,ethereum:mainnet,hyperevm:mainnet,robinhood:mainnet
VOX_NFT_EVM_CONFIRMATIONS=12

VOX_NFT_SOLANA_MAINNET_BETA_RPC_URL=
VOX_NFT_SOLANA_MAINNET_BETA_SIGNER_SECRET_NAME=vox-nft-solana-mainnet-beta-signer
VOX_NFT_SOLANA_MAINNET_BETA_SIGNER_KEY_PATH=

VOX_NFT_BASE_MAINNET_RPC_URL=
VOX_NFT_BASE_MAINNET_CHAIN_ID=
VOX_NFT_BASE_MAINNET_CONTRACT=
VOX_NFT_BASE_MAINNET_SIGNER_SECRET_NAME=vox-nft-base-mainnet-signer
VOX_NFT_BASE_MAINNET_SIGNER_KEY_PATH=

VOX_NFT_MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
VOX_NFT_MONAD_MAINNET_CHAIN_ID=143
VOX_NFT_MONAD_MAINNET_CONTRACT=0x87ef9e71625878a0babeee7864fa7d96ed4e3571
VOX_NFT_MONAD_MAINNET_SIGNER_SECRET_NAME=vox-nft-monad-mainnet-signer
VOX_NFT_MONAD_MAINNET_SIGNER_KEY_PATH=/run/secrets/vox-nft/monad_mainnet/signer

VOX_NFT_ARBITRUM_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc
VOX_NFT_ARBITRUM_MAINNET_CHAIN_ID=42161
VOX_NFT_ARBITRUM_MAINNET_CONTRACT=
VOX_NFT_ARBITRUM_MAINNET_SIGNER_SECRET_NAME=vox-nft-arbitrum-mainnet-signer
VOX_NFT_ARBITRUM_MAINNET_SIGNER_KEY_PATH=

VOX_NFT_ETHEREUM_MAINNET_RPC_URL=
VOX_NFT_ETHEREUM_MAINNET_CHAIN_ID=1
VOX_NFT_ETHEREUM_MAINNET_CONTRACT=
VOX_NFT_ETHEREUM_MAINNET_SIGNER_SECRET_NAME=vox-nft-ethereum-mainnet-signer
VOX_NFT_ETHEREUM_MAINNET_SIGNER_KEY_PATH=

VOX_NFT_HYPEREVM_MAINNET_RPC_URL=https://rpc.hyperliquid.xyz/evm
VOX_NFT_HYPEREVM_MAINNET_CHAIN_ID=999
VOX_NFT_HYPEREVM_MAINNET_CONTRACT=
VOX_NFT_HYPEREVM_MAINNET_SIGNER_SECRET_NAME=vox-nft-hyperevm-mainnet-signer
VOX_NFT_HYPEREVM_MAINNET_SIGNER_KEY_PATH=

VOX_NFT_ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VOX_NFT_ROBINHOOD_MAINNET_CHAIN_ID=4663
VOX_NFT_ROBINHOOD_MAINNET_CONTRACT=
VOX_NFT_ROBINHOOD_MAINNET_SIGNER_SECRET_NAME=vox-nft-robinhood-mainnet-signer
VOX_NFT_ROBINHOOD_MAINNET_SIGNER_KEY_PATH=
